{
	"name": "watchers-hub",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"test": "turbo run test",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "turbo run check-types",
		"changeset": "changeset",
		"version:packages": "changeset version",
		"release": "changeset publish",
		"drizzle": "pnpm --filter @mingull/database drizzle"
	},
	"devDependencies": {
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"turbo": "^2.10.12",
		"typescript": "7.0.2"
	},
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=24"
	}
}
