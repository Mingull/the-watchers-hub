{
	"extends": "@mingull/typescript-config/nextjs.json",
	"compilerOptions": {
		"paths": {
			"@/*": ["./src/*"],
			"@mingull/ui/*": ["../../packages/ui/src/*"]
		},
		"plugins": [{ "name": "next" }],
		"allowArbitraryExtensions": true
	},
	"include": ["next-env.d.ts", "next.config.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "src/components/header/index.tsx"],
	"exclude": ["node_modules"]
}
